# Python
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.pyd

# 构建产物
build/
tauri-app/build/
dist/*
tauri-app/dist/*
tauri-app/dist-web/
tauri-app/node_modules/
tauri-app/src-tauri/target/
tauri-app/src-tauri/target-*/
*.tsbuildinfo
*.spec.bak

# vendor 目录（由 build_suite.py --sync-only 生成，不入库）
vendor/

# 独立模块目录（MODULES），参与 PR 提交
# 排除嵌套 git 仓库的内部 .git 目录（避免子模块冲突）
modules/*/.git/
# 排除各子工具内的构建产物和缓存
modules/*/build/
modules/*/dist/
modules/*/__pycache__/
modules/*/*.pyc

# IDE 和系统文件
.vscode/
.idea/
.cursor/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# 日志和临时文件
*.log
*.tmp
.tmp/
pack_build.log
tools/kanzhang/导出耗时日志.jsonl
tauri-app/logs/

# 测试缓存
.pytest_cache/

# Local experiments and verification artifacts
scratchpad/
verification_screenshots/
tauri-app/verification_screenshots/
tauri-app/design-demos/
tauri-app/tmp/
*.bak-*

# Local agent/editor settings
**/.claude/settings.local.json
