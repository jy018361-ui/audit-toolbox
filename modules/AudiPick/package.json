{
  "name": "audipick",
  "version": "1.4.6",
  "description": "AudiPick 智能合同审计助手",
  "main": "main.js",
  "author": "AudiPick",
  "license": "MIT",
  "dependencies": {
    "pdfjs-dist": "3.11.174",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0"
  },
  "scripts": {
    "postinstall": "node scripts/setup_pdfjs_vendor.js",
    "setup:pdfjs": "node scripts/setup_pdfjs_vendor.js",
    "start": "npm run setup:pdfjs && electron .",
    "check:js": "python scripts/extract_main_js.py && node --check scripts/_check.js",
    "test:associations": "node scripts/test_project_associations.cjs",
    "test:ai-response": "node scripts/test_ai_response.cjs",
    "test:revenue": "node scripts/test_revenue_workpaper_rules.cjs",
    "test:revenue-answers": "node scripts/test_revenue_fixed_answers.cjs",
    "test:themes": "node scripts/test_themes.cjs",
    "test:loan": "node scripts/test_loan_audit.cjs",
    "test:dashboard": "node scripts/test_project_dashboard.cjs",
    "test:reader": "node scripts/test_workpaper_reader.cjs",
    "test:resume-export": "node scripts/test_background_resume_export.cjs",
    "test": "npm run test:associations && npm run test:ai-response && npm run test:revenue && npm run test:revenue-answers && npm run test:loan && npm run test:dashboard && npm run test:reader && npm run test:themes && npm run test:resume-export && npm run check:js",
    "dist": "npm run setup:pdfjs && electron-builder --win",
    "dist:portable": "npm run check:js && npm run setup:pdfjs && electron-builder --win portable",
    "dist:nsis": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.audipick.app",
    "productName": "AudiPick",
    "files": [
      "main.js",
      "preload.js",
      "audipick.html",
      "rules/**",
      "vendor/pdfjs/**",
      "vendor/xlsx/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AudiPick"
    },
    "portable": {
      "artifactName": "AudiPick-便携版-${version}.exe"
    }
  }
}
