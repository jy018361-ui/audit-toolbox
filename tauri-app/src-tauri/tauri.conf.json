{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "E点通工具箱",
  "version": "2.0.0-alpha.39",
  "identifier": "com.audittoolbox.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist-web"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "E点通工具箱",
      "width": 1440,
      "height": 900,
      "minWidth": 1000,
      "minHeight": 680,
      "center": true,
      "resizable": true,
      "decorations": false,
      "dragDropEnabled": true
    }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost",
      "capabilities": ["main-capability"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "windows": {
      "webviewInstallMode": { "type": "skip" },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "startMenuFolder": "E点通工具箱"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU4Mzc2QjM3QTQxOTFEOApSV1RZa1VGNnMzYURCZFJwanFET3gvMi90Rzd2eFhFTlZIekNOeE1zSkE5eUVaVnZxQ2F5OVhoQQo=",
      "endpoints": [
        "https://github.com/jy018361-ui/audit-toolbox/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
